{
  "name": "@jujulego/janus",
  "version": "2.0.2",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jujulego/janus-v2"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "./bin",
    "./dist"
  ],
  "type": "module",
  "bin": "./bin/janus.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "codegen": "graphql-codegen-esm --config graphql.config.yml",
    "build": "jill run 'build:bundle // build:dts // build:types'",
    "build:bundle": "rollup -c",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:types": "tsc -p tsconfig.build.json",
    "watch": "rollup -c --watch",
    "dev:start": "nodemon ./bin/janus.js -- start -v",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@graphql-tools/merge": "^9.0.3",
    "@jujulego/quick-tag": "^1.0.1",
    "@jujulego/utils": "^3.0.4",
    "@kyrielle/injector": "^1.0.0",
    "@kyrielle/logger": "^2.0.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@swc/helpers": "^0.5.11",
    "ajv": "^8.12.0",
    "chalk": "^5.3.0",
    "chalk-template": "^1.1.0",
    "cosmiconfig": "^9.0.0",
    "graphql": "^16.8.1",
    "graphql-sse": "^2.5.2",
    "graphql-yoga": "^5.0.0",
    "http-errors": "^2.0.0",
    "http-proxy": "^1.18.1",
    "ink": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "is-unicode-supported": "^2.0.0",
    "kyrielle": "^2.2.1",
    "log-symbols": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.2.0",
    "reflect-metadata": "^0.2.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "1.9.1",
    "@eslint/compat": "1.4.1",
    "@eslint/js": "9.39.3",
    "@graphql-codegen/cli": "6.1.2",
    "@graphql-codegen/client-preset": "5.2.3",
    "@graphql-codegen/typescript": "5.0.8",
    "@graphql-codegen/typescript-resolvers": "5.1.6",
    "@graphql-eslint/eslint-plugin": "4.4.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@jujulego/jill": "3.0.7",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@parcel/watcher": "2.5.6",
    "@rollup/plugin-graphql": "2.0.5",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.11",
    "@types/http-errors": "2.0.5",
    "@types/http-proxy": "1.17.17",
    "@types/node": "24.10.13",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/supertest": "6.0.3",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/utils": "8.53.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.6.9",
    "eslint": "9.39.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.3.0",
    "graphql-tag": "2.12.6",
    "ink-testing-library": "4.0.0",
    "jiti": "2.6.1",
    "memfs": "4.56.10",
    "msw": "2.12.10",
    "nodemon": "3.1.14",
    "rollup": "4.59.0",
    "shx": "0.4.0",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.12.0"
}
